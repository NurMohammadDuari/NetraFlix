<?xml version="1.0" encoding="UTF-8"?>
<!-- NetraFlix sitemap.
     Replace YOUR-DOMAIN with your real domain.
     This covers the static top-level routes. Detail pages (e.g. /movie/:id,
     /watch/:id) are dynamic — to get them indexed, generate additional <url>
     entries from your backend's catalog. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://YOUR-DOMAIN/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://YOUR-DOMAIN/movies</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://YOUR-DOMAIN/tv</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://YOUR-DOMAIN/anime</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://YOUR-DOMAIN/search</loc>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://YOUR-DOMAIN/docs</loc>
    <changefreq>monthly</changefreq>
    <priority>0.4</priority>
  </url>
</urlset>
